{
  "name": "@qualicanvas/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "QualiCanvas Desktop — GUI de escritorio (Electron + React + Vite) para el núcleo CAQDAS",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "predev": "npm run build -w @qualicanvas/core",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run build -w @qualicanvas/core && npm run build:main && vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "start": "electron .",
    "e2e": "node e2e/smoke.mjs",
    "rebuild:native": "electron-rebuild -f -w ../core better-sqlite3",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@qualicanvas/core": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.7.3",
    "vite": "^7.3.6",
    "wait-on": "^8.0.2"
  }
}
